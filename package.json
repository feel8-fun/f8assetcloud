{
  "name": "@feel8/assetcloud",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "dev:single": "npm run web:build && wrangler dev --port 8787",
    "deploy": "npm run web:build && wrangler deploy",
    "web:dev": "npm --prefix ./console_web run dev",
    "web:build": "npm --prefix ./console_web run build",
    "web:preview": "npm --prefix ./console_web run preview",
    "test": "node --test test/**/*.test.js",
    "d1:migrate": "wrangler d1 migrations apply DB --remote",
    "d1:migrate:local": "wrangler d1 migrations apply DB --local",
    "d1:migrate:preview": "wrangler d1 migrations apply DB --remote --preview",
    "d1:reset:remote": "sh ./scripts/reset_d1.sh remote",
    "d1:reset:preview": "sh ./scripts/reset_d1.sh preview",
    "test:console": "npm --prefix ./console_web run test",
    "typecheck": "tsc -p tsconfig.json",
    "test:d1": "node scripts/check_d1_migrations.js",
    "check": "npm run typecheck && npm test && npm run test:d1 && npm run test:console && npm run web:build"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2",
    "wrangler": "^4.80.0"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "better-auth": "^1.5.6",
    "chanfana": "^3.3.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.10",
    "zod": "^4.3.6"
  },
  "version": "0.1.0"
}
